aws_region          = "ap-northeast-1"
vpc_id              = "vpc-xxxxxxxxxxxxxxxxx"
public_subnet_ids   = ["subnet-public-a", "subnet-public-c"]
private_subnet_ids  = ["subnet-private-a", "subnet-private-c"]
api_domain_name     = "api.revenue.example.com"
route53_zone_id     = "Z0000000000000000000"
raw_data_bucket_name = "replace-with-a-globally-unique-bucket-name"
image_tag           = "replace-with-git-commit-sha"

# Lower-cost single-task/single-cache-node settings; change for HA production.
api_desired_count          = 1
worker_desired_count       = 1
rds_instance_class         = "db.t4g.small"
redis_node_type            = "cache.t4g.small"
redis_num_cache_clusters   = 1
deletion_protection        = true
